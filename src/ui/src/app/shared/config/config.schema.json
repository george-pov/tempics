{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["environment", "apiBaseUrl"],
  "additionalProperties": false,
  "properties": {
    "environment": { "enum": ["local", "dev", "prod"] },
    "apiBaseUrl": { "type": "string", "minLength": 1 },
    "functionKey": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_+/=-]+$" }
  }
}
